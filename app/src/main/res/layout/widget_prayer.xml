<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu rounded gradasi. Hierarki: label kecil, lalu nama+waktu sholat (baris utama), lalu
     badge hitung mundur berbentuk pill. Sebelumnya 4 baris teks rata kiri tanpa pembeda ukuran
     yang tegas dan latar flat solid; sekarang lebih jelas mana yang utama dilihat sekilas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_next_label"
        android:textColor="#B2DFDB"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="@color/gold_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Hitung mundur: Chronometer berdetak sendiri di launcher (API 24+), jadi angkanya selalu
         tepat tanpa widget perlu disegarkan tiap menit. TextView di bawahnya hanya cadangan untuk
         Android < 7 (Chronometer belum bisa mundur) — salah satunya disembunyikan dari kode. -->
    <Chronometer
        android:id="@+id/widget_prayer_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_countdown_pill"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_prayer_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_countdown_pill"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text=""
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
