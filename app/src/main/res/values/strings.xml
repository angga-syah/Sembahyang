    <string name="ibadah_menu_tajwid_title">Panduan Tajwid</string>
    <string name="ibadah_menu_tajwid_subtitle">Kaidah bacaan &amp; arti warna di layar Qur\'an</string>
    <string name="tajwid_guide_title">Panduan Tajwid</string>
    <string name="tajwid_guide_intro">Kaidah bacaan tajwid yang dipakai untuk mewarnai teks Arab di layar baca Qur\'an. Warna tiap kartu di bawah SAMA PERSIS dengan warna yang tampil saat mode tajwid dinyalakan.</string>
    <string name="tajwid_guide_huruf_format">Huruf/pemicu: %s</string>

    <string name="tajwid_guide_qalqalah_title">Qalqalah</string>
    <string name="tajwid_guide_qalqalah_desc">Pantulan suara yang jelas pada huruf qalqalah ketika bersukun atau saat berhenti (waqaf) di akhir bacaan, membuat huruf terdengar memantul, bukan lembek.</string>
    <string name="tajwid_guide_qalqalah_huruf">ق ط ب ج د</string>

    <string name="tajwid_guide_ghunnah_title">Ghunnah</string>
    <string name="tajwid_guide_ghunnah_desc">Dengung yang jelas dan mantap pada huruf nun atau mim yang bertasydid, ditahan kurang lebih 2 harakat (ketukan).</string>
    <string name="tajwid_guide_ghunnah_huruf">نّ  ·  مّ</string>

    <string name="tajwid_guide_iqlab_title">Iqlab</string>
    <string name="tajwid_guide_iqlab_desc">Nun sukun atau tanwin yang bertemu huruf ba diubah bunyinya menjadi mim, disertai dengung — ditandai tanda mim kecil di atas huruf pada mushaf.</string>
    <string name="tajwid_guide_iqlab_huruf">ب</string>

    <string name="tajwid_guide_ikhfa_title">Ikhfa</string>
    <string name="tajwid_guide_ikhfa_desc">Nun sukun atau tanwin dibaca samar — antara jelas dan lebur — disertai dengung, ketika bertemu salah satu dari 15 huruf ikhfa.</string>
    <string name="tajwid_guide_ikhfa_huruf">ت ث ج د ذ ز س ش ص ض ط ظ ف ق ك</string>

    <string name="tajwid_guide_ikhfa_syafawi_title">Ikhfa Syafawi</string>
    <string name="tajwid_guide_ikhfa_syafawi_desc">Mim sukun dibaca samar disertai dengung ketika bertemu huruf ba — mirip ikhfa biasa, tapi pemicunya mim sukun, bukan nun sukun/tanwin.</string>
    <string name="tajwid_guide_ikhfa_syafawi_huruf">ب (setelah مْ)</string>

    <string name="tajwid_guide_idgham_bighunnah_title">Idgham Bighunnah</string>
    <string name="tajwid_guide_idgham_bighunnah_desc">Nun sukun atau tanwin melebur ke huruf berikutnya disertai dengung, ketika bertemu salah satu dari 4 huruf ini.</string>
    <string name="tajwid_guide_idgham_bighunnah_huruf">ي ن م و</string>

    <string name="tajwid_guide_idgham_bilaghunnah_title">Idgham Bilaghunnah</string>
    <string name="tajwid_guide_idgham_bilaghunnah_desc">Nun sukun atau tanwin melebur ke huruf berikutnya TANPA dengung, ketika bertemu ra atau lam.</string>
    <string name="tajwid_guide_idgham_bilaghunnah_huruf">ر ل</string>

    <string name="tajwid_guide_idgham_mimi_title">Idgham Mimi (Syafawi)</string>
    <string name="tajwid_guide_idgham_mimi_desc">Mim sukun melebur ke mim berikutnya disertai dengung, ketika dua mim bertemu berurutan.</string>
    <string name="tajwid_guide_idgham_mimi_huruf">م (setelah مْ)</string>

    <string name="tajwid_guide_madd_thabii_title">Mad Thabi\'i (Mad Asli)</string>
    <string name="tajwid_guide_madd_thabii_desc">Pemanjangan bacaan alami sepanjang 2 harakat pada huruf mad (alif, wau, ya) yang memenuhi syarat — tanpa hamzah atau sukun sesudahnya.</string>
    <string name="tajwid_guide_madd_thabii_huruf">ا  ·  وْ (setelah dhammah)  ·  يْ (setelah kasrah)</string>

    <string name="tajwid_guide_madd_muttasil_title">Mad Wajib Muttasil</string>
    <string name="tajwid_guide_madd_muttasil_desc">Huruf mad bertemu hamzah DALAM SATU KATA yang sama, dibaca panjang 4-5 harakat.</string>

    <string name="tajwid_guide_madd_munfasil_title">Mad Jaiz Munfasil</string>
    <string name="tajwid_guide_madd_munfasil_desc">Huruf mad di akhir kata bertemu hamzah di AWAL KATA BERIKUTNYA, dibaca panjang 2-5 harakat.</string>

    <string name="tajwid_guide_madd_lazim_title">Mad Lazim</string>
    <string name="tajwid_guide_madd_lazim_desc">Huruf mad bertemu huruf yang bersukun atau bertasydid dalam satu kata, dibaca panjang penuh 6 harakat.</string>

    <string name="tajwid_guide_madd_arid_title">Mad Arid Lissukun</string>
    <string name="tajwid_guide_madd_arid_desc">Huruf mad bertemu akhir ayat atau tempat berhenti (waqaf) — boleh dibaca 2, 4, atau 6 harakat tergantung pilihan pembaca.</string>

    <string name="tajwid_guide_madd_generic_huruf">ا  ·  و  ·  ي (sebagai huruf mad)</string>

    <string name="tajwid_guide_hamzat_wasl_title">Hamzat Wasl</string>
    <string name="tajwid_guide_hamzat_wasl_desc">Hamzah penyambung yang HANYA dibaca saat memulai bacaan dari kata itu — dilewati (tidak dibaca) kalau bacaan disambung dari kata sebelumnya.</string>
    <string name="tajwid_guide_hamzat_wasl_huruf">ٱ</string>

    <string name="tajwid_guide_lam_syamsiyah_title">Lam Syamsiyah</string>
    <string name="tajwid_guide_lam_syamsiyah_desc">Huruf lam pada kata sandang "al-" yang tidak dibaca — bunyinya melebur ke huruf syamsiyah berikutnya (ditandai tasydid pada mushaf).</string>
    <string name="tajwid_guide_lam_syamsiyah_huruf">ت ث د ذ ر ز س ش ص ض ط ظ ل ن</string>

    <string name="tajwid_guide_silent_title">Huruf/Tanda Diam</string>
    <string name="tajwid_guide_silent_desc">Huruf yang tertulis pada mushaf tapi TIDAK dilafalkan sama sekali — misalnya alif tambahan setelah wau jama\'ah (mis. قَالُوا۟), yang murni penanda bentuk jamak.</string>
    <string name="tajwid_guide_silent_huruf">ا (setelah وا di akhir kata)</string>

