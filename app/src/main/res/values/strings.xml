    <string name="ibadah_menu_waris_title">Kalkulator Waris</string>
    <string name="ibadah_menu_waris_subtitle">Pembagian faraid ahli waris utama</string>
    <string name="waris_title">Kalkulator Waris</string>
    <string name="waris_disclaimer">Cakupan kalkulator ini HANYA ahli waris utama: pasangan, anak, ayah, ibu. Kalkulator ini TIDAK memperhitungkan kakek/nenek, saudara kandung/seayah/seibu, atau ahli waris lain — kehadiran mereka mengubah pembagian. Hasil di sini adalah alat bantu hitung, BUKAN fatwa. Untuk kasus nyata, konsultasikan ke ahli faraid, ustadz, atau notaris syariah. Harta yang dibagi adalah harta bersih setelah dikurangi biaya pengurusan jenazah, utang, dan wasiat (maksimal 1/3 harta).</string>
    <string name="waris_pewaris_label">Jenis kelamin pewaris (yang meninggal)</string>
    <string name="waris_pewaris_lakilaki">Laki-laki</string>
    <string name="waris_pewaris_perempuan">Perempuan</string>
    <string name="waris_jumlah_istri_label">Jumlah istri yang masih hidup</string>
    <string name="waris_suami_hidup_label">Suami masih hidup</string>
    <string name="waris_anak_lakilaki_label">Jumlah anak laki-laki hidup</string>
    <string name="waris_anak_perempuan_label">Jumlah anak perempuan hidup</string>
    <string name="waris_ayah_hidup_label">Ayah pewaris masih hidup</string>
    <string name="waris_ibu_hidup_label">Ibu pewaris masih hidup</string>
    <string name="waris_harta_label">Total harta warisan bersih (Rp, opsional)</string>
    <string name="waris_no_heir">Isi minimal satu ahli waris untuk melihat hasil.</string>
    <string name="waris_result_title">Pembagian</string>
    <string name="waris_fraksi_format">%.1f%%</string>
    <string name="waris_amount_per_person_format">%1$s per orang (%2$d orang, total %3$s)</string>
    <string name="waris_aul_note">Total bagian tetap melebihi 1 (\'aul) — semua bagian di atas sudah diperkecil proporsional secara otomatis, sesuai kaidah baku.</string>
    <string name="waris_radd_note">Ada sisa harta yang tidak terbagi ke ahli waris manapun dalam cakupan kalkulator ini. Ini bisa berarti ada ahli waris lain (kakek/nenek/saudara) yang berhak, atau butuh radd (pengembalian sisa) — WAJIB konsultasi ke ahli faraid untuk kasus ini.</string>
