# Salin berkas ini jadi keystore.properties lalu isi nilainya.
# JANGAN commit keystore.properties maupun berkas .jks — keduanya sudah masuk .gitignore.
#
# Membuat keystore baru (sekali saja, simpan baik-baik — kalau hilang, aplikasi tidak bisa
# diperbarui lagi oleh pengguna yang sudah memasangnya):
#
#   keytool -genkey -v -keystore sholat-release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias sholat
#
storeFile=sholat-release.jks
storePassword=GANTI_DENGAN_KATA_SANDI_KEYSTORE
keyAlias=sholat
keyPassword=GANTI_DENGAN_KATA_SANDI_KEY
